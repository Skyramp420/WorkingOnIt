{
  "name": "workingonit",
  "productName": "WorkingOnIt",
  "version": "1.6.3",
  "description": "Pomocník pre strihačov videa: nástenka zákaziek, meranie času, rendery, nápady a peniaze.",
  "author": "Alex Troják",
  "repository": "github:Skyramp420/WorkingOnIt",
  "main": "src/main/main.js",
  "private": true,
  "woi": {
    "mobileUrl": ""
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always",
    "test": "node test/run-tests.js"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "electron-updater": "6.8.9",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "sk.shapefx.workingonit",
    "productName": "WorkingOnIt",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/@fontsource*/**/files/*cyrillic*",
      "!node_modules/@fontsource*/**/files/*greek*",
      "!node_modules/@fontsource*/**/files/*vietnamese*",
      "!node_modules/@fontsource*/**/files/*.woff",
      "!node_modules/**/{README,CHANGELOG,HISTORY}*",
      "!node_modules/**/*.{md,map,ts}"
    ],
    "electronLanguages": ["sk", "cs", "en-US", "en-GB"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.png",
      "artifactName": "WorkingOnIt-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WorkingOnIt",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      { "provider": "github", "releaseType": "release" }
    ],
    "asarUnpack": [
      "assets/**",
      "src/mcp/**",
      "src/shared/**"
    ]
  }
}
